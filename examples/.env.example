# Database Configuration
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=berserk_auth
DB_USER=postgres
DB_PASSWORD=password

# Authentication
AUTH_SECRET=your-super-secret-key-change-in-production-min-32-chars
COOKIE_SECRET=cookie-secret-key
SESSION_SECRET=session-secret-key

# Server
NODE_ENV=development
PORT=3000

# Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/berserk_auth?schema=public"
