{
	"name": "@fusengine/berserk-engine",
	"version": "2.0.0",
	"author": "Bruno Azoulay <info@fusengine.ch>",
	"license": "MIT",
	"description": "Berserk engine run start application",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"berserk": "ts-node src/index.ts",
		"dev": "NODE_ENV=development nodemon --exec ts-node src/index.ts",
		"prod": "NODE_ENV=production node dist/index.js",
		"test": "NODE_ENV=test nodemon --exec ts-node src/index.ts",
		"prepublishOnly": "yarn build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://npm.pkg.github.com/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/fusengine/berserk-engine"
	},
	"files": [
		"LICENCE",
		"README.md",
		"dist/",
		"src/"
	],
	"engines": {
		"node": ">= 8.9.0"
	},
	"resolutions": {
		"acorn": "^7.1.1"
	},
	"dependencies": {
		"acorn": "^8.11.3",
		"bcrypt": "^5.1.1",
		"clear": "^0.1.0",
		"colors": "^1.4.0",
		"ejs": "^3.1.9",
		"ejs-mate": "^4.0.0",
		"errorhandler": "^1.5.1",
		"express": "^4.18.2",
		"http-errors": "^2.0.0",
		"log-symbols": "^5.0.0",
		"mongoose": "^8.1.0",
		"morgan": "^1.10.0",
		"pug": "^3.0.2"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/clear": "^0.1.4",
		"@types/errorhandler": "^1.5.3",
		"@types/express": "^4.17.21",
		"@types/http-errors": "^2.0.4",
		"@types/mongoose": "^5.11.97",
		"@types/morgan": "^1.9.9",
		"@types/node": "^20.11.5",
		"concurrently": "^8.2.2",
		"nodemon": "^3.0.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.3.3"
	},
	"keywords": [
		"rest",
		"restful",
		"router",
		"app",
		"api",
		"web",
		"route",
		"routing",
		"pug",
		"ejs"
	]
}
